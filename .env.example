# Copy to .env.local for development. Set the same values in your host's dashboard for production.

# Public address of the deployed site (used for SEO links, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email (optional). Without these the form shows a fallback contact option.
# Get a key at https://resend.com
RESEND_API_KEY=
# Where form messages are delivered.
CONTACT_TO_EMAIL=
# Optional: a sender on a domain you have verified with Resend.
CONTACT_FROM_EMAIL=
